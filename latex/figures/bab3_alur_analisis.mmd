flowchart TB
    L1["1. Audit sumber, registri asal-usul,<br/>pembekuan garis dasar"] --> L2["2. Penandaan pusat sekunder<br/>berbasis massa (penduduk, volume hunian)"]
    L2 --> L3a["3a. Integrasi kecamatan<br/>% komuter ke kawasan inti (WSM 2024)"]
    L2 --> L3b["3b. Relasi kab/kota<br/>matriks komuter 2014, 2019, 2023"]
    L3a --> L4["4. Fungsi harapan dan residu per domain<br/>layanan: binomial negatif · pekerjaan: log-linear<br/>prediksi leave-one-out"]
    L4 --> L5["5. Manfaat dan beban<br/>indikator terpisah, dua tingkat"]
    L3b --> L5
    L5 --> L6["6. Kemiringan residu terhadap integrasi<br/>dengan kontrol penjelasan alternatif"]
    L6 --> G1{{"Gerbang bukti terpenuhi?"}}
    G1 -- ya --> L6b["Tipologi ringkasan<br/>tujuh kategori"]
    G1 -- tidak --> L6c["Klaim diturunkan:<br/>profil, surplus/defisit relatif"]
    L6b --> L7["7. Diagnostik spasial dan uji ketahanan"]
    L6c --> L7
    L7 --> G2{{"Pemicu cadangan K1–K8?"}}
    G2 -- ya --> CB["Terapkan cadangan bernama,<br/>laporkan selisih hasil"]
    CB --> L7
    G2 -- tidak --> L8["8. Keluaran: tabel, peta, manifest,<br/>batas klaim, Web GIS dan what-if"]

